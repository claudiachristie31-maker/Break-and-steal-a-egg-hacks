local listLayout = Instance.new("UIListLayout")
listLayout.Padding = UDim.new(0, 3)
listLayout.Parent = petList

local eggCount
local petsFolder
local hatchFunction
local busy = false

local function connectInventory()
    eggCount = player:FindFirstChild("EggCount")
    petsFolder = player:FindFirstChild("Pets")
    hatchFunction = ReplicatedStorage:FindFirstChild("HatchEgg")

    if eggCount and eggCount:IsA("IntValue") then
        eggLabel.Text = "Eggs: " .. eggCount.Value
    else
        eggLabel.Text = "Eggs: unavailable"
    end

    for _, child in ipairs(petList:GetChildren()) do
        if child:IsA("TextLabel") then
            child:Destroy()
        end
    end

    if petsFolder then
        local total = 0
        for _, pet in ipairs(petsFolder:GetChildren()) do
            total += 1
            local label = makeLabel(
                "🐾 " .. pet.Name,
                UDim2.new(),
                UDim2.new(1, -8, 0, 24),
                petList
            )
            label.TextXAlignment = Enum.TextXAlignment.Left
        end

        if total == 0 then
            makeLabel("No pets yet", UDim2.new(),
                UDim2.new(1, -8, 0, 24), petList)
        end
    else
        makeLabel("Pet inventory unavailable",
            UDim2.new(), UDim2.new(1, -8, 0, 24), petList)
    end
end

task.spawn(function()
    while gui.Parent do
        connectInventory()
        task.wait(1)
    end
end)

hatchButton.Activated:Connect(function()
    if busy then return end

    eggCount = player:FindFirstChild("EggCount")
    hatchFunction = ReplicatedStorage:FindFirstChild("HatchEgg")

    if not eggCount or not hatchFunction then
        status.Text = "Egg system missing. Check server script."
        return
    end

    if eggCount.Value < 1 then
        status.Text = "Steal an egg first!"
        return
    end

    busy = true
    hatchButton.Text = "HATCHING..."

    local ok, success, result = pcall(function()
        return hatchFunction:InvokeServer()
    end)

    if not ok then
        status.Text = "Server error. Check Studio Output."
    elseif success then
        status.Text = "You hatched: " .. tostring(result) .. "!"
    else
        status.Text = tostring(result or "Could not hatch egg.")
    end

    connectInventory()
    hatchButton.Text = "BREAK AN EGG"
    busy = false
end)
