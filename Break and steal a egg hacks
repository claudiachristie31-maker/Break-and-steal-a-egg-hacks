listLayout.Parent = petList

local function refreshInventory()
    local count = player:FindFirstChild("EggCount")
    local pets = player:FindFirstChild("Pets")

    if count and count:IsA("IntValue") then
        eggLabel.Text = "Eggs: " .. count.Value
    else
        eggLabel.Text = "Eggs: loading..."
    end

    for _, child in ipairs(petList:GetChildren()) do
        if child:IsA("TextLabel") then
            child:Destroy()
        end
    end

    if not pets then
        makeLabel(
            "Waiting for pet inventory...",
            UDim2.new(),
            UDim2.new(1, -8, 0, 24),
            petList
        )
        return
    end

    local total = 0

    for _, pet in ipairs(pets:GetChildren()) do
        total += 1
        local label = makeLabel(
            "🐾 " .. pet.Name,
            UDim2.new(),
            UDim2.new(1, -8, 0, 24),
            petList
        )
        label.TextXAlignment = Enum.TextXAlignment.Left
    end

    if total == 0 then
        makeLabel(
            "No pets yet",
            UDim2.new(),
            UDim2.new(1, -8, 0, 24),
            petList
        )
    end
end

-- Update immediately when inventory changes
task.spawn(function()
    while gui.Parent do
        refreshInventory()
        task.wait(0.5)
    end
end)

hatchButton.Activated:Connect(function()
    if hatchButton:GetAttribute("Busy") then
        return
    end

    local count = player:FindFirstChild("EggCount")
    local hatchFunction = ReplicatedStorage:FindFirstChild("HatchEgg")

    if not count or not count:IsA("IntValue") then
        status.Text = "Egg inventory is loading."
        return
    end

    if not hatchFunction or not hatchFunction:IsA("RemoteFunction") then
        status.Text = "HatchEgg missing. Check EggGameServer."
        return
    end

    if count.Value < 1 then
        status.Text = "Collect an egg first!"
        return
    end

    hatchButton:SetAttribute("Busy", true)
    hatchButton.Text = "HATCHING..."

    local callOK, success, result = pcall(function()
        return hatchFunction:InvokeServer()
    end)

    if not callOK then
        status.Text = "Hatch failed. Check Studio Output."
    elseif success then
        status.Text = "You hatched: " .. tostring(result) .. "!"
    else
        status.Text = tostring(result or "Could not hatch egg.")
    end

    refreshInventory()
    hatchButton.Text = "BREAK AN EGG"
    hatchButton:SetAttribute("Busy", false)
end)

print("NickoyPanel loaded successfully.")
